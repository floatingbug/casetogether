NODE_ENV=development
PORT=3000
# Optional: Bind-Adresse des HTTP-Servers; hinter nginx auf 127.0.0.1 belassen.
HOST=127.0.0.1
MONGODB_URI=mongodb://localhost:27017/casetogether
# Erforderlich für signierte HttpOnly-Auth-Sessions (ADR-002): lokal mindestens 32 Byte Zufall erzeugen, nie committen.
SESSION_SECRET=replace-with-long-random-secret
# Optional: Ohne diese Werte nutzen Backend, Readiness und Spiel den vollständigen Fragenkatalog ohne Provideraufrufe.
OPENAI_API_KEY=
OPENAI_MODEL=
FRONTEND_ORIGIN=http://localhost:5173
# Optional, Build-Zeit, leer = relativ: absolute Backend-Origin für getrennt gehostete Frontends
# (z. B. Vercel). Ohne Wert nutzt das Frontend weiterhin Same-Origin-Requests über den Dev-Proxy.
VITE_API_ORIGIN=https://api.casetogether.tasse-voll-code.de
